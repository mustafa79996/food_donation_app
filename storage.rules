rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Donation images: readable by everyone, uploaded by authenticated users, images only <= 10MB
    match /donations/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Welfare certificates: readable by authenticated users and admin, uploaded by registering centre
    match /certificates/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024;
    }

    // General fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
