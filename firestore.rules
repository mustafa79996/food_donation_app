rules_version = '2';
service cloud_firestore {
  match /databases/{database}/documents {
    // Allow read for everyone so donations and centres always load without permission errors
    match /donations/{donationId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /welfare_centres/{centreId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /public_welfare_centres/{centreId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    match /mail/{mailId} {
      allow read, write: if true;
    }
  }
}
